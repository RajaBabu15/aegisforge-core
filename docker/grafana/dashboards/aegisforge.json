{
  "title": "AegisForge",
  "uid": "aegisforge",
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Token consumption",
      "targets": [
        {
          "expr": "sum by (tenant_id, model) (rate(aegisforge_token_consumption_total[5m]))",
          "legendFormat": "{{tenant_id}} {{model}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Tool latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(aegisforge_tool_execution_duration_seconds_bucket[5m])))",
          "legendFormat": "{{tool}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "Evaluation scores",
      "targets": [
        {
          "expr": "aegisforge_agent_evaluation_score",
          "legendFormat": "{{metric}}"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
    }
  ]
}
